<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>

    <!-- Network server (listening on localhost) -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Network client (forwarding to Ollama on localhost:11434) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Process inspection (CPU/RAM telemetry) -->
    <key>com.apple.security.system-information</key>
    <true/>
</dict>
</plist>